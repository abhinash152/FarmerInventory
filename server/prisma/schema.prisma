datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Farmer {
  farmer_id      Int             @id @default(autoincrement())
  full_name      String
  username       String          @unique
  password_hash  String
  contact_number String?
  farm_location  String?
  created_at     DateTime?       @default(now())

  products       Product[]
  orders         Order[]
  sales          Sale[]
  feedbacks      OrderFeedback[]
  notifications  Notification[]
  complaints     Complaint[]

  @@map("farmers")
}

model Customer {
  customer_id    Int             @id @default(autoincrement())
  customer_name  String
  contact_number String?
  address        String?
  username       String          @unique
  password_hash  String
  created_at     DateTime?       @default(now())

  orders         Order[]
  sales          Sale[]
  feedbacks      OrderFeedback[]
  complaints     Complaint[]

  @@map("customers")
}

model Product {
  product_id          Int             @id @default(autoincrement())
  farmer_id           Int
  product_name        String
  category            String?
  stock_quantity      Int             @default(0)
  unit                String
  price_per_unit      Float
  low_stock_threshold Int?            @default(5)
  image_url           String?
  harvest_date        DateTime?
  storage_condition   String?
  created_at          DateTime?       @default(now())
  updated_at          DateTime?       @default(now()) @updatedAt

  farmer              Farmer          @relation(fields: [farmer_id], references: [farmer_id], onDelete: Cascade)
  orders              Order[]
  sales               Sale[]
  feedbacks           OrderFeedback[]
  complaints          Complaint[]

  @@index([farmer_id], map: "idx_products_farmer")
  @@index([product_name], map: "idx_products_name")
  @@map("products")
}

model Order {
  order_id     Int             @id @default(autoincrement())
  customer_id  Int
  farmer_id    Int
  product_id   Int
  quantity     Int
  status       String          @default("PENDING")
  requested_at DateTime?       @default(now())
  responded_at DateTime?

  customer     Customer        @relation(fields: [customer_id], references: [customer_id], onDelete: Cascade)
  farmer       Farmer          @relation(fields: [farmer_id], references: [farmer_id], onDelete: Cascade)
  product      Product         @relation(fields: [product_id], references: [product_id], onDelete: Cascade)

  feedback     OrderFeedback?
  extension    OrderExtension?
  complaints   Complaint[]

  @@index([status], map: "idx_orders_status")
  @@index([farmer_id], map: "idx_orders_farmer")
  @@map("orders")
}

model Sale {
  sale_id       Int       @id @default(autoincrement())
  product_id    Int
  customer_id   Int
  farmer_id     Int
  quantity_sold Int
  total_amount  Float
  sale_date     DateTime? @default(now())

  product       Product   @relation(fields: [product_id], references: [product_id])
  customer      Customer  @relation(fields: [customer_id], references: [customer_id])
  farmer        Farmer    @relation(fields: [farmer_id], references: [farmer_id])

  @@index([farmer_id], map: "idx_sales_farmer")
  @@index([sale_date], map: "idx_sales_date")
  @@map("sales")
}

model OrderFeedback {
  feedback_id Int       @id @default(autoincrement())
  order_id    Int       @unique
  customer_id Int
  farmer_id   Int
  product_id  Int
  rating      Int
  comment     String?
  created_at  DateTime? @default(now())

  order       Order     @relation(fields: [order_id], references: [order_id], onDelete: Cascade)
  customer    Customer  @relation(fields: [customer_id], references: [customer_id], onDelete: Cascade)
  farmer      Farmer    @relation(fields: [farmer_id], references: [farmer_id], onDelete: Cascade)
  product     Product   @relation(fields: [product_id], references: [product_id], onDelete: Cascade)

  @@map("order_feedback")
}

model OrderExtension {
  ext_id             Int     @id @default(autoincrement())
  order_id           Int     @unique
  payment_method     String  @default("COD")
  payment_status     String  @default("PENDING")
  delivery_pincode   String?
  delivery_fee       Float   @default(0.0)
  delivery_address   String?
  tracking_step      String  @default("PLACED")
  estimated_delivery String?

  order              Order   @relation(fields: [order_id], references: [order_id], onDelete: Cascade)

  @@map("order_details_ext")
}

model ChatMessage {
  message_id   Int       @id @default(autoincrement())
  farmer_id    Int
  customer_id  Int
  sender_role  String
  message_text String
  is_read      Boolean   @default(false)
  created_at   DateTime? @default(now())

  @@index([farmer_id, customer_id], map: "idx_chat_participants")
  @@map("chat_messages")
}

model Notification {
  notification_id Int       @id @default(autoincrement())
  farmer_id       Int
  product_id      Int?
  title           String
  message         String
  type            String    @default("INFO")
  is_read         Boolean   @default(false)
  created_at      DateTime? @default(now())

  farmer          Farmer    @relation(fields: [farmer_id], references: [farmer_id], onDelete: Cascade)

  @@map("notifications")
}

model Complaint {
  complaint_id Int       @id @default(autoincrement())
  order_id     Int
  customer_id  Int
  farmer_id    Int
  product_id   Int
  issue_type   String
  description  String
  proof_image  String?
  status       String    @default("PENDING")
  resolution   String?
  created_at   DateTime? @default(now())

  order        Order     @relation(fields: [order_id], references: [order_id], onDelete: Cascade)
  customer     Customer  @relation(fields: [customer_id], references: [customer_id], onDelete: Cascade)
  farmer       Farmer    @relation(fields: [farmer_id], references: [farmer_id], onDelete: Cascade)
  product      Product   @relation(fields: [product_id], references: [product_id], onDelete: Cascade)

  @@index([farmer_id], map: "idx_complaint_farmer")
  @@index([product_id], map: "idx_complaint_product")
  @@map("complaints")
}
